/**
 * @fileoverview Firestore Security Rules for TaxiTao Application
 *
 * SECURITY MODEL: Split-Data Architecture
 * ========================================
 * This ruleset implements a split-data model where:
 * - Public booking data (areas, times, fares) is readable by any driver
 * - Private customer data (phone, exact addresses) requires active subscription
 *
 * COLLECTIONS:
 * - /users/{userId}: Private user profiles (role, driverId)
 * - /drivers/{driverId}: Public driver profiles (readable by anyone)
 * - /vehicles/{vehicleId}: Public vehicle info (readable by anyone)
 * - /bookingRequests/{id}: PUBLIC ride data (areas, date/time, fare estimate)
 * - /bookingRequestPrivate/{id}: PRIVATE customer data (phone, exact addresses) - SUBSCRIPTION REQUIRED
 * - /rideShares/{shareId}: Shared link metadata with timestamps for ±3 min verification
 * - /paymentVerifications/{id}: M-Pesa confirmation tracking
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user's email is verified (REQUIRED for account access)
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Check if user owns this resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check if the user document exists
    function hasUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Get current user's profile data.
    // Returns null if user document does not exist (safe for all callers).
    function getUserData() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    // Check if user is admin (requires email verification)
    function isAdmin() {
      return isSignedIn() &&
             isEmailVerified() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin' &&
             (!("suspended" in getUserData()) || getUserData().suspended != true);
    }

    // Check if user is a driver (requires email verification)
    function isDriver() {
      return isSignedIn() &&
             isEmailVerified() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'driver' &&
             (!("suspended" in getUserData()) || getUserData().suspended != true);
    }

    // Get driver's subscription data (only for drivers)
    function getDriverSubscription() {
      let userData = getUserData();
      return (userData != null && userData.driverId != null)
        ? get(/databases/$(database)/documents/drivers/$(userData.driverId)).data
        : null;
    }

    // Check if driver has ACTIVE subscription (critical for private data access)
    function isSubscribedDriver() {
      return isDriver() &&
             getUserData().driverId != null &&
             getDriverSubscription() != null &&
             getDriverSubscription().subscriptionStatus == 'active' &&
             getDriverSubscription().isVisibleToPublic == true;
    }

    // Check if user is a car hire / vendor company representative
    function isCarHire() {
      return isSignedIn() && (
        request.auth.token.role == 'car_hire' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'car_hire' &&
          (!("suspended" in getUserData()) || getUserData().suspended != true)
        )
      );
    }

    // Check if user is a car hire or assistant
     function isCarHireOrAssistant() {
       return isSignedIn() && (
         request.auth.token.role == 'car_hire' ||
         request.auth.token.role == 'assistant' ||
         (
           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (getUserData().role == 'car_hire' || getUserData().role == 'assistant') &&
           (!("suspended" in getUserData()) || getUserData().suspended != true)
         )
       );
     }

     // Check if user is a car-hire company staff member (separate from platform assistant)
     // This is for company-specific operational access, NOT platform admin access
     function isCarHireStaff() {
       return isSignedIn() && (
         request.auth.token.role == 'car_hire_staff' ||
         (
           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserData().role == 'car_hire_staff' &&
           (!("suspended" in getUserData()) || getUserData().suspended != true)
         )
       );
     }

     // Check if user has a specific granular permission (for assistants)
    function hasGranularPermission(permissionName) {
      return isSignedIn() && isEmailVerified() && hasUserData() &&
             getUserData().role == 'assistant' &&
             getUserData().permissions != null &&
             getUserData().permissions[permissionName] == true;
    }

    // Check if current user matches the driver for a resource
    function driverMatches(driverId) {
      // Allow match by auth uid OR driverId stored on profile (even if role not set yet)
      return isSignedIn() && (
        request.auth.uid == driverId ||
        (getUserData() != null && getUserData().driverId == driverId)
      );
    }

    // Check if current user owns a peer-to-peer hire request for a personal driver vehicle
    function isP2PHireOwner() {
      return ("driverId" in resource.data) &&
             resource.data.driverId != null &&
             driverMatches(resource.data.driverId);
    }

    // Prevent P2P hire updates from moving a request to another customer, vehicle, or owner
    function p2pHireIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'driverId',
        'customerId',
        'vehicleId',
        'companyId'
      ]);
    }

    // Check if requester is allowed to see/update a negotiation
    function negotiationParticipant(driverId, customerId) {
      return isAdmin() ||
             driverMatches(driverId) ||
             (isSignedIn() && customerId != null && request.auth.uid == customerId);
    }

    // Prevent mutation of immutable negotiation fields on updates
    function negotiationImmutableFieldsUnchanged() {
      return request.resource.data.driverId == resource.data.driverId &&
             request.resource.data.customerId == resource.data.customerId &&
             request.resource.data.bookingRequestId == resource.data.bookingRequestId &&
             request.resource.data.customerName == resource.data.customerName &&
             request.resource.data.customerPhone == resource.data.customerPhone &&
             request.resource.data.initialPrice == resource.data.initialPrice &&
             request.resource.data.proposedPrice == resource.data.proposedPrice;
    }

    // ============================================================
    // PUBLIC COLLECTIONS (Must be at top for guest access)
    // ============================================================

    match /drivers/{driverId} {
      allow read, list: if true;

      // Drivers can create their own profile (during signup, before email verification), or admins can create any
      allow create: if isSignedIn() && (
        request.auth.uid == driverId ||
        isAdmin()
      );

      // Drivers can update their own profile (email verification required), or admins can update any
      allow update: if isSignedIn() && (
        (request.auth.uid == driverId && isEmailVerified()) ||
        isAdmin() ||
        (isSignedIn() && getUserData().role == 'assistant' && isEmailVerified())
      );

      // Only admins can delete driver profiles
      allow delete: if isSignedIn() && isAdmin();

      // Nested vehicles subcollection
      match /vehicles/{vehicleId} {
        allow read, list: if true;
        allow write: if isSignedIn() && (isOwner(driverId) || isAdmin());
      }

      // Nested payments subcollection
      match /payments/{paymentId} {
        allow read: if isSignedIn() && (isOwner(driverId) || isAdmin());
        allow write: if isSignedIn() && isOwner(driverId);
      }

      // Nested verification events audit subcollection
      match /verificationEvents/{eventId} {
        allow read, list: if isSignedIn() && (
          isOwner(driverId) ||
          isAdmin() ||
          (getUserData().role == 'assistant' && getUserData().permissions.manageDrivers == true)
        );
        allow create: if isSignedIn() && (
          isAdmin() ||
          (getUserData().role == 'assistant' && getUserData().permissions.manageDrivers == true)
        );
        allow update, delete: if false; // Audit logs are immutable and cannot be tampered with
      }
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.driverId == request.auth.uid ||
        isAdmin() ||
        (isCarHireOrAssistant() && (
          request.resource.data.companyId == getUserData().companyId ||
          request.resource.data.companyId == request.auth.uid
        )) ||
        (isCarHireStaff() && (
          request.resource.data.companyId == getUserData().companyId
        ))
      );
      allow update, delete: if isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        isAdmin() ||
        (isCarHireOrAssistant() && (
          resource.data.companyId == getUserData().companyId ||
          resource.data.companyId == request.auth.uid
        )) ||
        (isCarHireStaff() && (
          resource.data.companyId == getUserData().companyId
        ))
      );
    }


    // ============================================================
    // USER PROFILES
    // ============================================================
    match /users/{userId} {
      // Users can read their own profile or admins can read all
      // Also allow assistants with manageUsers or manageDrivers permission to read driver or user profiles
      // Also allow car_hire_staff to read their own profile
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (
          getUserData().role == 'assistant' &&
          (getUserData().permissions.manageUsers == true || getUserData().permissions.manageDrivers == true)
        ) ||
        (
          (getUserData().role == 'car_hire' || request.auth.token.role == 'car_hire') &&
          resource.data.companyId == getUserData().companyId &&
          (resource.data.role == 'assistant' || resource.data.role == 'car_hire_staff')
        ) ||
        (
          isCarHireStaff() &&
          request.auth.uid == userId
        )
      );

      // Users can create their own profile (email verification not required during signup)
       // Admins can create any profile
       // Also allow company owners (role car_hire) to create user documents for company staff (car_hire_staff).
       allow create: if isSignedIn() && (
         isOwner(userId) ||
         isAdmin() ||
         (
           (getUserData().role == 'car_hire' || request.auth.token.role == 'car_hire') &&
           request.resource.data.companyId == getUserData().companyId &&
           (request.resource.data.role == 'assistant' || request.resource.data.role == 'car_hire_staff')
         )
       );

      // Users can update their own profile (email verification required, or basic info / push tokens if unverified during onboarding) or admins can update any.
       // Also allow company owners (role car_hire) to update their company staff's permissions Map (strictly limited to company scope).
       allow update: if isSignedIn() && (
         (isOwner(userId) && (
           isEmailVerified() ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'phone', 'bio', 'yearsOfExperience', 'verification', 'emailVerified',
             'verificationEmailSent', 'verificationEmailSentSentCount', 'pushToken', 'pushTokenUpdatedAt', 'companyId'
           ])
         )) ||
         isAdmin() ||
         (
           getUserData().role == 'assistant' &&
           getUserData().permissions.manageDrivers == true &&
           resource.data.role == 'driver' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verification', 'emailVerified'])
         ) ||
          (
            (getUserData().role == 'car_hire' || request.auth.token.role == 'car_hire') &&
            (resource.data.companyId == getUserData().companyId || resource.data.companyId == request.auth.uid) &&
            (request.resource.data.companyId == getUserData().companyId || request.resource.data.companyId == null) &&
            (resource.data.role == 'assistant' || resource.data.role == 'car_hire_staff') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions', 'companyId'])
          )
       );

      // Admins can delete any user. Car-hire owners can delete their own staff.
       allow delete: if isAdmin() || (
         isSignedIn() &&
         (getUserData().role == 'car_hire' || request.auth.token.role == 'car_hire') &&
         resource.data.companyId == getUserData().companyId &&
         (resource.data.role == 'assistant' || resource.data.role == 'car_hire_staff')
       );

       // Admins can list all users.
       // Also allow company owners (role car_hire) to list staff belonging to their company.
       // Also allow assistants with manageUsers or manageDrivers permission to list users.
       allow list: if isAdmin() || (
        isSignedIn() &&
        (getUserData().role == 'car_hire' || request.auth.token.role == 'car_hire')
      ) || (
        isSignedIn() &&
        getUserData().role == 'assistant' &&
        (getUserData().permissions.manageUsers == true || getUserData().permissions.manageDrivers == true)
      );

      // Push tokens subcollection (device tokens for notifications)
      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ============================================================
    // RATE LIMITS
    // ============================================================
    match /rateLimits/{limitId} {
      // Users can read/write their own rate limits; admins can manage all
      allow read, write: if isSignedIn() && (
        limitId.startsWith(request.auth.uid + ':') || isAdmin()
      );
    }

    // ============================================================
    // ACCOUNT DELETION REQUESTS
    // ============================================================
    match /accountDeletionRequests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // DRIVER ROUTES (TaxiTao Mobile compatibility)
    // ============================================================
    match /driverRoutes/{routeId} {
      // Anyone can read routes (customers need to see pricing options)
      allow read: if request.auth != null;

      // Only the route owner (driver) can create/modify/delete
      allow create: if request.auth != null && request.auth.uid == request.resource.data.driverId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.driverId;
    }


    // ============================================================
    // BOOKING REQUESTS - PUBLIC DATA ONLY
    // Contains: pickupArea, dropoffArea, pickupDate, pickupTime,
    //           estimatedFare, status, passengers
    // Does NOT contain: customerPhone, customerName, exact addresses
    // ============================================================
    match /bookingRequests/{bookingId} {
      // Any authenticated user with verified email can create a booking request
      allow create: if isSignedIn() && isEmailVerified();

      // Any authenticated user with verified email can read (drivers scan for rides in area)
      allow read: if isSignedIn() && isEmailVerified();

      // Update logic - multi-party access (email verification required)
      allow update: if isSignedIn() && isEmailVerified() && (
        // Customer who created the booking (can cancel, negotiate, confirm)
        request.auth.uid == resource.data.customerId ||

        // Driver who accepted the booking (can update status and location)
        request.auth.uid == resource.data.acceptedBy ||
        request.auth.uid == resource.data.acceptedDriverId ||

        // Targeted driver (can accept a specifically-assigned ride)
        request.auth.uid == resource.data.targetDriverId ||

        // Any driver can negotiate or accept a pending/broadcast ride
        (isDriver() && (
          resource.data.status == 'pending' ||
          resource.data.status == 'searching' ||
          resource.data.status == 'offered' ||
          resource.data.status == 'price_pending'
        ))
      );

      // Allow deletion of rides under specific conditions (email verification required):
      // 1. Driver can delete only rides explicitly marked expired and assigned to them
      // 2. Customer can delete their own cancelled rides (for cleanup)
      allow delete: if isSignedIn() && isEmailVerified() && (
        // Admin can delete any booking request
        isAdmin() ||

        // Driver can delete only expired rides connected to their driver identity
        (resource.data.status == 'expired' && (
          request.auth.uid == resource.data.acceptedBy ||
          request.auth.uid == resource.data.acceptedDriverId ||
          request.auth.uid == resource.data.targetDriverId
        )) ||
        // Customer can delete their own cancelled rides
        (request.auth.uid == resource.data.customerId &&
         resource.data.status == 'cancelled')
      );
    }

    // ============================================================
    // PROPOSALS SUBCOLLECTION
    // ============================================================
    match /bookingRequests/{bookingId}/proposals/{proposalId} {
      // Driver can read/list proposals, customer who owns the booking request can read
      allow read, list: if isSignedIn() && isEmailVerified() && (
        isDriver() ||
        (exists(/databases/$(database)/documents/bookingRequests/$(bookingId)) &&
         request.auth.uid == get(/databases/$(database)/documents/bookingRequests/$(bookingId)).data.customerId)
      );

      // Driver can create their own proposal
      allow create: if isSignedIn() && isEmailVerified() && isDriver() &&
        request.resource.data.driverId == request.auth.uid;
      // Admins may also create proposals (e.g., for testing or manual overrides)
      allow create: if isAdmin();

      // Update proposal:
      // 1. Driver can update their own proposal (change price, proposedAt, negotiationRound, etc.)
      // 2. Customer can update the proposal status (accept/reject)
      allow update: if isSignedIn() && isEmailVerified() && (
        (isDriver() && resource.data.driverId == request.auth.uid && request.resource.data.driverId == request.auth.uid) ||
        (request.auth.uid == resource.data.customerId)
      );

      // Only admins can delete proposals
      allow delete: if isAdmin();
    }

    // ============================================================
    // PROPOSALS COLLECTION GROUP (For driver queries)
    // ============================================================
    match /{path=**}/proposals/{proposalId} {
      // Driver can query/list their own proposals across all booking requests
      allow read, list: if isSignedIn() && isEmailVerified() && (
        resource.data.driverId == request.auth.uid
      );
    }

    // ============================================================
    // BOOKING REQUESTS - PRIVATE DATA (SUBSCRIPTION REQUIRED)
    // Contains: customerName, customerPhone, exactPickup, exactDropoff
    // ============================================================
    match /bookingRequestPrivate/{bookingId} {
      // CRITICAL: Only subscribed drivers (with verified email) OR admins can read private data
      allow read: if isSignedIn() && isEmailVerified() && (isSubscribedDriver() || isAdmin());

      // Cloud Functions only (Admin SDK bypasses rules)
      allow create: if false;

      // Only admins can modify
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // RIDE SHARES (Time-gated link verification)
    // Used for ±3 minute payment verification
    // ============================================================
    match /rideShares/{shareId} {
      // Anyone can read (to validate share link exists) - no auth required for public links
      allow read: if true;

      // Only admins (or permitted assistants) can create share links (email verification required)
      allow create: if isSignedIn() && isEmailVerified() && (isAdmin() || hasGranularPermission('manageRides'));

      // Drivers can only claim a link for themselves, and only by changing claim fields.
      // Also allow the claimant to release their own claim (best-effort compensation if acceptance fails).
      allow update: if isSignedIn() && isEmailVerified() && isDriver() &&
        request.resource.data.bookingId == resource.data.bookingId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          // Claim: active -> claimed
          (
            resource.data.status == "active" &&
            request.resource.data.status == "claimed" &&
            request.resource.data.claimedBy == request.auth.uid
          ) ||
          // Release: claimed -> active (only by the current claimant)
          (
            resource.data.status == "claimed" &&
            resource.data.claimedBy == request.auth.uid &&
            request.resource.data.status == "active" &&
            request.resource.data.claimedBy == null &&
            request.resource.data.claimedAt == null
          )
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // PAYMENT VERIFICATIONS (M-Pesa confirmation tracking)
    // ============================================================
    match /paymentVerifications/{verificationId} {
      // Drivers can create verification requests (email verification required)
      allow create: if isSignedIn() && isEmailVerified() && isDriver();

      // Drivers can read their own (email verification required), admins can read all
      allow read: if isSignedIn() && isEmailVerified() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );

      // Only admins can verify/reject
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // USER BOOKINGS (Private user data)
    // ============================================================
    match /users/{userId}/bookings/{bookingId} {
      allow read, write: if isSignedIn() && isEmailVerified() && isOwner(userId);
    }

    // ============================================================
    // DRIVER PRICING
    // ============================================================
    match /driverPricing/{driverId} {
      allow read: if true; // Public pricing info
      allow write: if isSignedIn() && isEmailVerified() && (
        getUserData().driverId == driverId || isAdmin()
      );
    }

    // ============================================================
    // STANDARD PRICING
    // ============================================================
    match /pricing/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // NEGOTIATIONS
    // ============================================================
    match /negotiations/{negotiationId} {
      // Anyone can start a negotiation (guest customers allowed, but authenticated users need verified email)
      allow create: if !isSignedIn() || (isSignedIn() && isEmailVerified());

      // Read: participants (customer or driver) or admin (email verification required for authenticated users).
      // For guest negotiations (customerId == null), allow read by possession of the link/id.
      allow get: if !isSignedIn() ||
                 (isSignedIn() && isEmailVerified() && (
                   negotiationParticipant(resource.data.driverId, resource.data.customerId) ||
                   resource.data.customerId == null
                 ));

      // List: only participants (customer/driver) or admin to avoid broad enumeration (email verification required)
      allow list: if isSignedIn() && isEmailVerified() &&
                     negotiationParticipant(resource.data.driverId, resource.data.customerId);

      // Updates: participants or admin (email verification required), and guests when customerId is null,
      // while keeping immutable fields locked.
      allow update: if negotiationImmutableFieldsUnchanged() && (
        (!isSignedIn() || (isSignedIn() && isEmailVerified())) && (
          negotiationParticipant(resource.data.driverId, resource.data.customerId) ||
          (resource.data.customerId == null && request.resource.data.customerId == null)
        )
      );

      // Delete restricted to admins
      allow delete: if isAdmin();
    }

    // ============================================================
    // RIDE REQUESTS (Legacy fallback)
    // ============================================================
    match /rideRequests/{requestId} {
      allow create: if isSignedIn() && isEmailVerified();
      allow read: if isSignedIn() && (isDriver() || isAdmin());
      allow update: if isSignedIn() && (
        (isDriver() && resource.data.status == 'pending') ||
        (isDriver() && resource.data.driverId == getUserData().driverId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================
    match /notifications/{notificationId} {
      // Read: Only the recipient can read their notifications OR system_broadcast (email verification required)
      allow read: if isSignedIn() && isEmailVerified() && (
        request.auth.uid == resource.data.recipientId ||
        resource.data.recipientId == "system_broadcast"
      );

      // Authenticated user with verified email can create notifications (cross-party alerts)
      // Sender cannot be the recipient (prevents self-notification spam)
      allow create: if isSignedIn() && isEmailVerified() &&
        request.resource.data.recipientId != request.auth.uid;

      // Only recipient can update (e.g., mark as read) (email verification required)
      allow update: if isSignedIn() && isEmailVerified() && request.auth.uid == resource.data.recipientId;

      // No deletion
      allow delete: if false;
    }

    match /driverNotifications/{notificationId} {
      // Only the driver can read their notifications (email verification required)
      allow read: if isSignedIn() && isEmailVerified() && request.auth.uid == resource.data.driverId;

      // Anyone authenticated with verified email can create (customer confirms, system alerts)
      allow create: if isSignedIn() && isEmailVerified();

      // Only driver can update (e.g., mark as read) (email verification required)
      allow update: if isSignedIn() && isEmailVerified() && request.auth.uid == resource.data.driverId;

      // No deletion
      allow delete: if false;
    }

    // ============================================================
    // ISSUES COLLECTION (Issue reports from customers and drivers)
    // ============================================================
    match /issues/{issueId} {
      // Users can read their own issues (email verification required), admins can read all
      allow read: if isSignedIn() && isEmailVerified() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );

      // Any authenticated user with verified email can create their own issue report
      // Must match userId and have valid userType (customer or driver)
      allow create: if isSignedIn() && isEmailVerified() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.userType in ['customer', 'driver'];

      // Only admins can update issue status
      allow update: if isAdmin();

      // No deletion
      allow delete: if false;
    }

    // ============================================================
    // TESTING PHASE COLLECTIONS
    // ============================================================

    // APP SETTINGS (global)
    // ============================================================
    match /appSettings/{settingId} {
      allow read: if isSignedIn() && isEmailVerified();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // ADMIN PORTAL — PROTECTED COLLECTIONS
    // ============================================================

    // Admin action audit trail — only admins (and assistants with viewAnalytics)
    // can list/read. Writes are done via server-side Cloud Functions only.
    match /adminAuditLogs/{eventId} {
      allow read, list: if isAdmin();
      allow create: if false; // Cloud Functions write only
      allow update, delete: if false;
    }

    // Admin action audit events — used for direct client-side logging by the admin portal.
    match /adminAuditEvents/{eventId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // App crash reports (web portal name — mirrors crashReports collection)
    // Clients create; admins manage.
    match /app_crashes/{crashId} {
      allow create: if isSignedIn() && isEmailVerified();
      allow read, list: if isAdmin();
      allow update: if isAdmin(); // mark resolved
      allow delete: if false;
    }

    // Per-admin notification/display settings
    match /adminSettings/{adminUid} {
      allow read, write: if isSignedIn() && isAdmin() && isOwner(adminUid);
    }

    // Admin-managed ride share links
    match /shareLinks/{linkId} {
      allow read, list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Per-driver aggregated proposal/earnings stats — system writes, admin reads
    match /driverStats/{statId} {
      allow read, list: if isAdmin();
      allow write: if false; // Cloud Functions write only
    }

    // Per-vehicle ROI stats — system writes, admin reads
    match /vehicleStats/{statId} {
      allow read, list: if isAdmin();
      allow write: if false; // Cloud Functions write only
    }

    // Platform-wide aggregate stats and daily snapshots
    match /systemStats/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Cloud Functions write only
    }

    // Sensitive KYC documents for each driver (ID scans, license images)
    match /driver_private/{driverId} {
      // Allow drivers to read their own private KYC docs, admins, or authorized assistants.
      // Admins can read even if email verification status is not enforced on the admin token.
      allow read: if isSignedIn() && (
        isEmailVerified() && (driverMatches(driverId) ||
          (getUserData().role == 'assistant' && getUserData().permissions.manageDrivers == true)
        )
        || isAdmin()
      );

      // Driver creates/updates their own KYC submission, or admins/authorized assistants update statuses (e.g. paymentInfo)
      allow create, update: if isSignedIn() && isEmailVerified() && (
        driverMatches(driverId) ||
        isAdmin() ||
        (getUserData().role == 'assistant' && getUserData().permissions.manageDrivers == true)
      );

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Corporate fleet company profiles
    match /companies/{companyId} {
      // Allow any guest to get a company profile by ID (needed for onboarding)
      allow get: if true;
      // Company profiles can be read or listed by any signed-in user (including customers browsing or booking vehicles)
      allow list, read: if isSignedIn();
      // System/onboarding creates; admins or the representative can update
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        request.auth.token.role == 'car_hire' ||
        request.auth.uid == companyId ||
        getUserData().companyId == companyId ||
        isAdmin() ||
        isCarHireStaff()
      );
      allow delete: if isAdmin();
    }

    // Company invoices collection (queried by admins and company representatives)
    match /companyInvoices/{invoiceId} {
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'car_hire' ||
        request.auth.token.role == 'assistant' ||
        isCarHireOrAssistant() ||
        resource.data.companyId == getUserData().companyId ||
        resource.data.companyId == request.auth.uid
      );
      allow write: if isSignedIn() && isAdmin();
    }

    // ============================================================
    // HIRE REQUESTS (Car-hire / vendor portal)
    // Created by customers booking a company vehicle.
    // ============================================================
    match /hireRequests/{requestId} {
      // The customer, matching vendor/company staff, or matching P2P driver-owner can read it; admins read all
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        isCarHireOrAssistant() ||
        isCarHireStaff() ||
        request.auth.uid == resource.data.customerId ||
        isP2PHireOwner()
      );

      // Customers (and admins) can create hire requests
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == request.resource.data.customerId
      );

      // Vendor, assistant, or P2P driver-owner can update workflow status; customer can cancel
      allow update: if isSignedIn() && (
        isAdmin() ||
        ((request.auth.token.role == 'car_hire' || request.auth.token.role == 'assistant') && (
          request.auth.uid == resource.data.companyId ||
          request.auth.uid == request.resource.data.companyId ||
          getUserData().companyId == resource.data.companyId
        )) ||
        (isCarHireOrAssistant() && (
          getUserData().companyId == resource.data.companyId ||
          request.auth.uid == resource.data.companyId
        )) ||
        (isCarHireStaff() && (
          getUserData().companyId == resource.data.companyId
        )) ||
        (isP2PHireOwner() && p2pHireIdentityUnchanged()) ||
        request.auth.uid == resource.data.customerId
      );

      // Only admins can delete hire requests
      allow delete: if isAdmin();
    }

    // ============================================================
    // WORKSPACE INVITATIONS (Single-use expirable onboarding link)
    // ============================================================
    match /invitations/{tokenId} {
      // Allow any guest user to retrieve (get) an invitation to validate its status & expiration during signup
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && isCarHire());

      // Only authenticated company owners (vendors) can create workspace invitations
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isCarHire() && request.resource.data.companyId == getUserData().companyId)
      );

      // Allow updates to the invitation (candidate submits or CEO approves)
      allow update: if (
        // STATE 1: Candidate submits details (guest user, pending -> submitted)
        (
          resource.data.status == "pending" &&
          request.resource.data.status == "submitted" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'staffName', 'staffEmail', 'staffPhone', 'submittedAt'])
        ) ||
        // STATE 2: CEO approves the applicant (authenticated company owner, submitted -> approved)
        (
          isSignedIn() &&
          resource.data.status == "submitted" &&
          request.resource.data.status == "approved" &&
          // CEO can only approve tokens created by their company
          (resource.data.companyId == getUserData().companyId || resource.data.companyId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
        ) ||
        // STATE 3: Owner fixes broken companyId on invitations (sync operation)
        (
          isSignedIn() &&
          isCarHire() &&
          (resource.data.companyId == getUserData().companyId || resource.data.companyId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId'])
        )
      ) || isAdmin();

      // Only admins can delete tokens
      allow delete: if isAdmin();
    }

    // Issue reply threads (admin sends responses into this subcollection)
    match /issues/{issueId}/replies/{replyId} {
      // Issue owner or admin can read replies
      allow read, list: if isSignedIn() && isEmailVerified() && (
        (exists(/databases/$(database)/documents/issues/$(issueId)) &&
         get(/databases/$(database)/documents/issues/$(issueId)).data.userId == request.auth.uid) ||
        isAdmin()
      );
      // Only admins can create replies (admin responds to user)
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // MOBILE PARITY & EVENT LOGGING
    // ============================================================
    match /app_events/{eventId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /partnerAlerts/{alertId} {
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        (isCarHireOrAssistant() && getUserData().companyId == resource.data.companyId)
      );
      allow create: if isSignedIn() && isEmailVerified() && (
        isAdmin() ||
        (isCarHireOrAssistant() && getUserData().companyId == request.resource.data.companyId)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isCarHireOrAssistant() && getUserData().companyId == resource.data.companyId)
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isCarHireOrAssistant() && getUserData().companyId == resource.data.companyId)
      );
    }

    // ============================================================
    // HIRE PAYMENTS (Car-hire manual payment records)
    // Created by Cloud Function (submitHirePayment).
    // Client reads only — no direct client writes.
    // ============================================================
    match /hirePayments/{paymentId} {
      // Customer who made the payment, matching vendor/company staff, or admin can read
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        (isCarHireOrAssistant() && getUserData().companyId == resource.data.companyId) ||
        (isCarHireStaff() && getUserData().companyId == resource.data.companyId)
      );
      // Cloud Function handles all writes via Admin SDK — block direct client writes
      allow write: if false;
    }

    match /auditAlerts/{alertId} {
      allow read, update: if isAdmin();
      allow create: if isAdmin();
      allow delete: if false;
    }

    match /adminAlerts/{alertId} {
      allow read, list, update: if isSignedIn() && (
        isAdmin() ||
        (
          getUserData().role == 'assistant' &&
          (getUserData().permissions.manageDrivers == true || getUserData().permissions.manageUsers == true)
        )
      );
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // STAFF ACTIVITY LOGS (Governance tracking)
    // ============================================================
    match /staffActivityLogs/{logId} {
      allow read, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.staffId == request.auth.uid
      );
      allow create: if isSignedIn() && isEmailVerified();
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // DEFAULT: Block all access unless explicitly allowed
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
