# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
crash.log
firestore-debug.log
dev-output.log

# build logs
build-log*.txt
build_output*.txt
tsc_output*.txt
web-firestore-rules.txt

# Expo / mobile artifacts
.expo/
app.json
eas.json
temp_app/

# logs directory
logs/

# scratch (debug scripts with hardcoded secrets)
scratch/

# credentials
credentials/
*credentials*.json

# Firebase service account keys (NEVER commit)
*service-account*.json
firebase-service-account*.json
google-services.json

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
